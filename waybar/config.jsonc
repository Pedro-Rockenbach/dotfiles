{
  "position": "top",
  "spacing": 0,
  "height": 0,
  "margin-top": 8,
  "margin-bottom": 0,
  "margin-left": 9,
  "margin-right": 12,
  "modules-left": [
    "custom/omarchy",
    "group/left-island",
    "mpris"
  ],
  "custom/omarchy": {
    "format": "",
    "on-click": "rofi -show drun"
  },
  "group/left-island": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/workspaces"
    ]
  },
  "modules-center": [
    "clock"
  ],
  /* Módulos da direita soltos para formar uma única ilha no CSS */
  "modules-right": [
    "backlight",
    "bluetooth",
    "network",
    "pulseaudio",
    "memory",
    "cpu",
    "power-profiles-daemon",
    "battery"
  ],
  "hyprland/workspaces": {
    "all-outputs": true,
    "format": "{icon}",
    "show-special": false,
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "persistent-workspaces": {
      "*": [
        1,
        2,
        3,
        4,
        5
      ]
    }
  },
  "cpu": {
    "interval": 2,
    "format": "<span size='7pt' color='#df6124'>CPU </span>{usage}%"
  },
  "memory": {
    "interval": 2,
    "format": "<span size='7pt' color='#df6124'>MEM </span>{percentage}%"
  },
  "clock": {
    "format": "{:%H:%M - %a, %d}",
    "format-alt": "{:L%d %B W%V %Y}",
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "month": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    }
  },
  "network": {
    "format-icons": [
      "󰤯",
      "󰤟",
      "󰤢",
      "󰤥",
      "󰤨"
    ],
    "format": "{icon}",
    "format-wifi": "<span size='7pt' color='#df6124'>NET </span>{signalStrength}%",
    "format-ethernet": "<span size='7pt' color='#df6124'>NET </span>{bandwidthDownBytes:=}",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)",
    "tooltip-format-ethernet": "Connected",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1
  },
  "battery": {
    "format": "<span size='7pt' color='#df6124'>BAT </span>{capacity}%",
    "format-discharging": "<span size='7pt' color='#df6124'>BAT </span>{capacity}%",
    "format-charging": "<span size='7pt' color='#df6124'>BAT_c </span>{capacity}%",
    "format-plugged": "<span size='7pt' color='#df6124'>BAT_p </span>{capacity}%",
    "format-icons": {
      "charging": [
        "󰢜",
        "󰂆",
        "󰂇",
        "󰂈",
        "󰢝",
        "󰂉",
        "󰢞",
        "󰂊",
        "󰂋",
        "󰂅"
      ],
      "default": [
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ]
    },
    "format-full": "<span size='7pt' color='#df6124'>BAT_f </span>{capacity}%",
    "tooltip-format-discharging": "{timeTo}",
    "tooltip-format-charging": "{timeTo}",
    "interval": 5
  },
  "power-profiles-daemon": {
    "format": "<span size='7pt' color='#df6124'>POWER </span>{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "bluetooth": {
    "format": "<span size='7pt' color='#df6124'>BT </span>{status} {num_connections}",
    "format-disabled": "<span size='7pt' color='#df6124'>BT </span>{status}",
    "format-connected": "<span size='7pt' color='#df6124'>BT </span>{num_connections}",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "kitty bluetui"
  },
  "pulseaudio": {
    "format": "<span size='7pt' color='#df6124'>VOL </span>{volume}%",
    "on-click-right": "pamixer -t",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "headset": "",
      "default": [
        "",
        "",
        ""
      ]
    }
  },
  "backlight": {
    "device": "intel_backlight",
    "rotate": 0,
    "format": "<span size='7pt' color='#df6124'>BL </span>{percent}%",
    "tooltip-format": "🌕 {percent}%",
    "format-icons": [
      "󰃜",
      "󰃝",
      "󰃞",
      "󰃟",
      "󰃠"
    ]
  },
  "tray": {
    "icon-size": 11,
    "spacing": 5
  },

  "mpris": {
    "format": "   {artist} - {title}",
    "format-paused": "<span color='grey'>⏸  {artist} - {title}</span>",
    "max-length": 40,
    "ignored-players": [
      "firefox",
      "chromium",
      "brave"
    ]
  }
}
